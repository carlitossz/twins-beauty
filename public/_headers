# Cloudflare Pages: cabeceras de caché
# Los archivos de /assets llevan un código único en el nombre: se guardan por un año
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker y el index siempre se revisan, para que las actualizaciones lleguen de una
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
